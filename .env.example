# Postgres
POSTGRES_USER=sciterm
POSTGRES_PASSWORD=sciterm
POSTGRES_DB=sciterm
POSTGRES_PORT=5432

# Neo4j  (auth is user/password; NEO4J_AUTH is consumed by the container)
NEO4J_AUTH=neo4j/sciterm_dev_pw
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# What the driver dials. Keep the port in step with NEO4J_BOLT_PORT above.
NEO4J_URI=bolt://localhost:7687

# NCBI politeness. One budget for PubTator and PMC together, shared across every
# process via a single key on the broker's Redis (below).
NCBI_RATE_LIMIT_PER_SECOND=3.0
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# Redis (Celery broker + result backend)
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Redis (PubTator document cache) -- a separate instance, capped and evicting.
# Isolated from the broker so a full cache can never discard a queued task.
REDIS_CACHE_PORT=6380
REDIS_CACHE_URL=redis://localhost:6380/0
# 24h. Cached documents are re-fetchable, so this is a cost knob, not a limit.
DOCUMENT_CACHE_TTL_SECONDS=86400

# Embeddings
# Possible alternative: MedCPT
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# RAG search. Chunks scoring below this cosine similarity are discarded.
# Calibrated on this corpus with the bge query prefix: on-topic queries scored
# at worst 0.660, off-topic ones at best 0.444.
RAG_SCORE_THRESHOLD=0.55

# App
API_PORT=8000
UI_PORT=5173

# Environment. "local" leaves the app wide open exactly as it was before auth
# existed; "prod" gates the metered routes (import, chat, PubTator) behind an
# access code. One runtime switch, so the same bundle and image serve both.
SCITERM_ENV=local

# Auth. Required by the API process when SCITERM_ENV=prod -- it refuses to
# start without one, rather than minting tokens anyone could forge. Generate
# with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
#
# The Celery worker does NOT need this and should not be given it: it parses
# untrusted PubTator documents, so it is the more exposed process, and it has
# no reason to be able to mint admin tokens. Leave JWT_SECRET out of the
# worker's environment entirely -- api/auth/config.py is a separate settings
# class precisely so that omitting it cannot stop the worker booting.
#
# In a real deployment this comes from a secret store injected as an env var
# (an ECS task definition `secrets` block, for instance). Store it as a
# plaintext secret, not key/value JSON: injecting the whole JSON blob "works",
# silently, and breaks the day the JSON gains a second key.
# JWT_SECRET=
# How long an access token is trusted without a database check. Also the window
# in which a revoked session keeps working, so keep it short.
ACCESS_TOKEN_TTL_SECONDS=900
# How long a password (admin) session lives, slid forward on each refresh.
REFRESH_TOKEN_TTL_SECONDS=1209600
# The free-access window, measured from a code's FIRST redemption.
FREE_CODE_WINDOW_HOURS=48
# Rate limits on the unauthenticated auth endpoints, per process. Each login
# attempt costs ~200ms of PBKDF2, so the login limit is what bounds that work.
LOGIN_ATTEMPTS_PER_WINDOW=10
REDEEM_ATTEMPTS_PER_WINDOW=20
THROTTLE_WINDOW_SECONDS=300

# The refresh cookie is marked Secure in prod, so it is only ever sent over
# HTTPS. Set false ONLY to demo a prod build over plain HTTP -- otherwise the
# browser withholds the cookie and every session dies on reload.
# COOKIE_SECURE=true
