# Postgres
POSTGRES_USER=litgraph
POSTGRES_PASSWORD=litgraph
POSTGRES_DB=litgraph
POSTGRES_PORT=5432

# Neo4j  (auth is user/password; NEO4J_AUTH is consumed by the container)
NEO4J_AUTH=neo4j/litgraph_dev_pw
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Redis (Celery broker + result backend)
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# App
API_PORT=8000
UI_PORT=5173
