# Postgres
POSTGRES_USER=litgraph
POSTGRES_PASSWORD=litgraph
POSTGRES_DB=litgraph
POSTGRES_PORT=5432

# Neo4j  (auth is user/password; NEO4J_AUTH is consumed by the container)
NEO4J_AUTH=neo4j/litgraph_dev_pw
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# What the driver dials. Keep the port in step with NEO4J_BOLT_PORT above.
NEO4J_URI=bolt://localhost:7687

# NCBI politeness. One budget for PubTator and PMC together, shared across every
# process via a single key on the broker's Redis (below).
NCBI_RATE_LIMIT_PER_SECOND=3.0
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# Redis (Celery broker + result backend)
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Redis (PubTator document cache) -- a separate instance, capped and evicting.
# Isolated from the broker so a full cache can never discard a queued task.
REDIS_CACHE_PORT=6380
REDIS_CACHE_URL=redis://localhost:6380/0
# 24h. Cached documents are re-fetchable, so this is a cost knob, not a limit.
DOCUMENT_CACHE_TTL_SECONDS=86400

# Embeddings
# Possible alternative: MedCPT
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# RAG search. Chunks scoring below this cosine similarity are discarded.
# Calibrated on this corpus with the bge query prefix: on-topic queries scored
# at worst 0.660, off-topic ones at best 0.444.
RAG_SCORE_THRESHOLD=0.55

# App
API_PORT=8000
UI_PORT=5173
